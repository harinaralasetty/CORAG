# Copy to .env and fill in what you use. At least one of GOOGLE_API_KEY or ANTHROPIC_API_KEY is needed to chat.

GOOGLE_API_KEY=            # Gemini models and Google embeddings: https://aistudio.google.com/
ANTHROPIC_API_KEY=         # Claude models: https://console.anthropic.com/

# Embeddings (a chat keeps the provider it started with). With no Google, Voyage or OpenAI key the app
# uses a local sentence-transformers model, which needs no key.
VOYAGE_API_KEY=            # https://dash.voyageai.com/
OPENAI_API_KEY=            # https://platform.openai.com/

# Optional web search tool (used by Gemini models only)
SEARCH_PROVIDER=serpapi    # serpapi or tavily
SERPER_API_KEY=            # when SEARCH_PROVIDER=serpapi: https://serpapi.com/dashboard
TAVILY_API_KEY=            # when SEARCH_PROVIDER=tavily: https://app.tavily.com

# Where chats and document indexes are stored (default: ./data)
# CORAG_DATA_DIR=data
